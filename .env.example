# Salin file ini menjadi .env dan isi dengan API key Anda
# cp .env.example .env

# ── BPS Web API ────────────────────────────────────────────────────────────
# Daftar & ambil API key di: https://webapi.bps.go.id/
# Klik "Daftar" → verifikasi email → login → "API Key" di dashboard
BPS_API_KEY=

# ── Twitter / X API ────────────────────────────────────────────────────────
# Daftar developer account di: https://developer.twitter.com/
# Catatan: API berbayar ($100/bln), skip jika tidak punya
TWITTER_BEARER_TOKEN=

# ── YouTube Data API v3 ─────────────────────────────────────────────────────
# GRATIS — Cara mendapatkan:
# 1. Buka https://console.cloud.google.com/
# 2. Buat project baru (atau pilih yang ada)
# 3. APIs & Services → Enable APIs → cari "YouTube Data API v3" → Enable
# 4. APIs & Services → Credentials → Create Credentials → API Key
# 5. Salin API key ke sini
# Kuota gratis: 10.000 unit/hari (1 search = 100 unit → 100 search/hari)
YOUTUBE_API_KEY=
