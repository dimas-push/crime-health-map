# Salin file ini menjadi .env dan isi dengan API key Anda
# cp .env.example .env

# ── BPS Web API ────────────────────────────────────────────────────────────
# Daftar & ambil API key di: https://webapi.bps.go.id/
# Klik "Daftar" → verifikasi email → login → "API Key" di dashboard
BPS_API_KEY=

# ── Twitter / X API ────────────────────────────────────────────────────────
# Daftar developer account di: https://developer.twitter.com/
# Buat project → App → "Keys and Tokens" → Bearer Token
# Catatan: Free tier hanya bisa search 1 query/15 menit, 10 tweet/request
TWITTER_BEARER_TOKEN=
